name: Build IPA
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: macos-14
    steps:
      - uses: actions/checkout@v4
      - name: Unzip
        run: unzip -q CRMPLauncher-ios.zip
      - name: Install XcodeGen
        run: brew install xcodegen
      - name: Generate project
        working-directory: CRMPLauncher-ios
        run: xcodegen generate
      - name: Build
        working-directory: CRMPLauncher-ios
        run: |
          xcodebuild -project CRMPLauncher.xcodeproj -scheme CRMPLauncher \
            -configuration Release -sdk iphoneos -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" build
      - name: Pack IPA
        working-directory: CRMPLauncher-ios
        run: |
          mkdir Payload
          cp -R build/Build/Products/Release-iphoneos/CRMPLauncher.app Payload/
          zip -qr CRMPLauncher.ipa Payload
      - uses: actions/upload-artifact@v4
        with:
          name: CRMPLauncher-ipa
          path: CRMPLauncher-ios/CRMPLauncher.ipa
